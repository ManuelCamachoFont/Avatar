<?xml version="1.0" encoding="utf-8"?>
<RadioGroup xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rgEspecie"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <RadioButton
        android:id="@+id/rbElfo"
        style="@style/TextoDialogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/elfo" />

    <RadioButton
        android:id="@+id/rbEnano"
        style="@style/TextoDialogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/enano" />

    <RadioButton
        android:id="@+id/rbHobbit"
        style="@style/TextoDialogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hobbit" />

    <RadioButton
        android:id="@+id/rbHumano"
        style="@style/TextoDialogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/humano" />
</RadioGroup>
